void sendStatus() {
  String json = "{";
  json += "\"scan\":" + String(scanEnabled ? "true" : "false");
  json += ",\"scanAngle\":" + String(scanAngle);
  json += ",\"distance\":" + String(distanceCm);
  json += ",\"rudder\":" + String(rudderAngle);
  json += ",\"fire\":" + String(fireDetected ? "true" : "false");
  json += ",\"armed\":" + String(fireArmed ? "true" : "false");
  json += ",\"pump\":" + String(pumpOn ? "true" : "false");
  json += ",\"nanoOnline\":" +
      String(millis() - lastNanoStatus < 2000 ? "true" : "false");
  json += ",\"anomaly\":false";
  json += "}";

  server.send(200, "application/json", json);
}

void handleCommand() {
  String c = server.arg("cmd");
  c.toUpperCase();

  if (c == "SCAN_ON") {
    scanEnabled = true;
  } else if (c == "SCAN_OFF") {
    scanEnabled = false;
  } else if (c == "RUDDER_LEFT") {
    rudderAngle = 60;
    rudder.write(rudderAngle);
  } else if (c == "RUDDER_CENTER") {
    rudderAngle = 90;
    rudder.write(rudderAngle);
  } else if (c == "RUDDER_RIGHT") {
    rudderAngle = 120;
    rudder.write(rudderAngle);
  } else if (c.startsWith("RUDDER_SET_")) {
    int value = c.substring(11).toInt();
    if (value >= 45 && value <= 135) {
      rudderAngle = value;
      rudder.write(rudderAngle);
    }
  } else if (c == "FIRE_ARM") {
    sendNano("FIRE ARM");
  } else if (c == "FIRE_DISARM") {
    sendNano("FIRE DISARM");
  } else {
    server.send(400, "text/plain", "Unknown command");
    return;
  }

  server.send(200, "text/plain", "OK");
}

void setup() {
  Serial.begin(115200);
  nanoLink.begin(9600);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  digitalWrite(TRIG_PIN, LOW);

  scanner.attach(SCAN_SERVO_PIN);
  rudder.attach(RUDDER_SERVO_PIN);
  scanner.write(scanAngle);
  rudder.write(rudderAngle);

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  while (WiFi.status() != WL_CONNECTED) {
    delay(300);
    yield();
  }

  Serial.print("Dashboard: http://");
  Serial.println(WiFi.localIP());

  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", PAGE);
  });

  server.on("/api/status", HTTP_GET, sendStatus);
  server.on("/api/cmd", HTTP_GET, handleCommand);
  server.begin();
}

void loop() {
  server.handleClient();
  readNanoMessages();

  unsigned long now = millis();

  if (scanEnabled && now - lastScan >= 150) {
    lastScan = now;

    scanner.write(scanAngle);

    scanAngle += scanDirection * 10;

    if (scanAngle >= 160) {
      scanAngle = 160;
      scanDirection = -1;
    } else if (scanAngle <= 20) {
      scanAngle = 20;
      scanDirection = 1;
    }
  }

  if (scanEnabled && now - lastPing >= 180) {
    lastPing = now;
    distanceCm = readDistance();
  }

  yield();
}
