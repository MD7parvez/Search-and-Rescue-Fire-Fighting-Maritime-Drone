
#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <SoftwareSerial.h>
#include <Servo.h>

// Replace with your Wi-Fi credentials.
const char* WIFI_SSID = "Parvez";
const char* WIFI_PASSWORD = "   parvez777";

ESP8266WebServer server(80);

// NodeMCU RX, TX: D6, D5
SoftwareSerial nanoLink(D6, D5);

Servo scanner;
Servo rudder;

// GPIO pin assignments
const byte SCAN_SERVO_PIN = D1;
const byte RUDDER_SERVO_PIN = D2;
const byte TRIG_PIN = D7;
const byte ECHO_PIN = D0;

bool scanEnabled = false;
int scanAngle = 20;
int scanDirection = 1;
int rudderAngle = 90;

long distanceCm = -1;
int fireDetected = 0;
int pumpOn = 0;
int fireArmed = 0;

unsigned long lastScan = 0;
unsigned long lastPing = 0;
unsigned long lastNanoStatus = 0;

String nanoLine = "";

long readDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(3);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  unsigned long duration =
      pulseIn(ECHO_PIN, HIGH, 25000UL);

  if (duration == 0) return -1;
  return duration / 58;
}

void sendNano(String command) {
  nanoLink.println(command);
}

void readNanoMessages() {
  while (nanoLink.available()) {
    char c = nanoLink.read();

    if (c == '\n' || c == '\r') {
      if (nanoLine.startsWith("STATUS,")) {
        int p;

        p = nanoLine.indexOf("FIRE=");
        if (p >= 0)
          fireDetected = nanoLine.substring(p + 5).toInt();

        p = nanoLine.indexOf("ARMED=");
        if (p >= 0)
          fireArmed = nanoLine.substring(p + 6).toInt();

        p = nanoLine.indexOf("PUMP=");
        if (p >= 0)
          pumpOn = nanoLine.substring(p + 5).toInt();

        lastNanoStatus = millis();
      }

      nanoLine = "";
    } else if (nanoLine.length() < 100) {
      nanoLine += c;
    } else {
      nanoLine = "";
    }
  }
}

