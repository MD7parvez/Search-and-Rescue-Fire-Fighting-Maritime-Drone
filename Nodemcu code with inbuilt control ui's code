function drawRadar() {
  const canvas = document.getElementById('radar');
  const ctx = canvas.getContext('2d');
  const cx = 160, cy = 235, radius = 205;

  ctx.clearRect(0,0,320,260);
  ctx.strokeStyle='#236c61';
  ctx.lineWidth=1;

  [50,100,150,200].forEach(r => {
    ctx.beginPath();
    ctx.arc(cx,cy,r,Math.PI,2*Math.PI);
    ctx.stroke();
  });

  [0,45,90,135,180].forEach(a => {
    const t = Math.PI + a*Math.PI/180;
    ctx.beginPath();
    ctx.moveTo(cx,cy);
    ctx.lineTo(cx+radius*Math.cos(t),
                cy+radius*Math.sin(t));
    ctx.stroke();
  });

  const a = Math.PI + latest.angle*Math.PI/180;
  ctx.strokeStyle='#46edb0';
  ctx.lineWidth=2;
  ctx.beginPath();
  ctx.moveTo(cx,cy);
  ctx.lineTo(cx+radius*Math.cos(a),
              cy+radius*Math.sin(a));
  ctx.stroke();

  if (latest.distance >= 0 && latest.distance <= 400) {
    const r = latest.distance/400*radius;
    ctx.fillStyle='#ffd166';
    ctx.beginPath();
    ctx.arc(cx+r*Math.cos(a),cy+r*Math.sin(a),5,0,2*Math.PI);
    ctx.fill();
